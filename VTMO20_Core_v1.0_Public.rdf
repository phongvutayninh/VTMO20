<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/vtmo/ontology#"
     xml:base="https://w3id.org/vtmo/ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vtmo="https://w3id.org/vtmo/ontology#"
     xmlns:terms="http://purl.org/dc/terms/">
   <owl:Ontology rdf:about="https://w3id.org/vtmo/ontology">
    <owl:versionIRI rdf:resource="https://w3id.org/vtmo/ontology/1.0.0"/>

    <terms:identifier>VTMO20-Core-v1.0</terms:identifier>
    <terms:creator>Trần Phong Vũ</terms:creator>

    <terms:title xml:lang="en">Vietnamese Traditional Medicinal Plant Ontology</terms:title>

    <rdfs:label xml:lang="en">Vietnamese Traditional Medicinal Plant Ontology</rdfs:label>
    <rdfs:label xml:lang="vi">Bản thể tri thức cây thuốc Y học cổ truyền Việt Nam</rdfs:label>

    <terms:description xml:lang="en">VTMO20 is a competency-driven OWL ontology developed to represent structured knowledge about Vietnamese traditional medicinal plants.</terms:description>

    <terms:language>en</terms:language>
    <terms:language>vi</terms:language>

    <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-13</terms:issued>
    <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-13</terms:modified>

    <terms:provenance xml:lang="en">VTMO20 Core v1.0 was developed through a competency-driven ontology engineering workflow comprising curated source knowledge, competency questions, ontology modelling, SPARQL validation, and reproducibility evidence.</terms:provenance>

    <terms:subject xml:lang="en">Knowledge Graph</terms:subject>
    <terms:subject xml:lang="en">Medicinal Plants</terms:subject>
    <terms:subject xml:lang="en">Ontology Engineering</terms:subject>
    <terms:subject xml:lang="en">Semantic Web</terms:subject>
    <terms:subject xml:lang="en">Traditional Medicine</terms:subject>
    <terms:subject xml:lang="en">Vietnamese Traditional Medicine</terms:subject>

    <owl:versionInfo>1.0.0</owl:versionInfo>
</owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/language -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/language"/>
    


    <!-- http://purl.org/dc/terms/provenance -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/provenance"/>
    


    <!-- http://purl.org/dc/terms/subject -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/subject"/>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/vtmo/ontology#belongsToFamily -->

    <owl:ObjectProperty rdf:about="https://w3id.org/vtmo/ontology#belongsToFamily">
        <rdfs:domain rdf:resource="https://w3id.org/vtmo/ontology#MedicinalSubstance"/>
        <rdfs:range rdf:resource="https://w3id.org/vtmo/ontology#PlantFamily"/>
        <rdfs:comment xml:lang="en">Relates a medicinal substance to its botanical family.</rdfs:comment>
        <rdfs:label xml:lang="en">belongs to family</rdfs:label>
        <rdfs:label xml:lang="vi">thuộc họ thực vật</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/vtmo/ontology#belongsToMeridian -->

    <owl:ObjectProperty rdf:about="https://w3id.org/vtmo/ontology#belongsToMeridian">
        <rdfs:domain rdf:resource="https://w3id.org/vtmo/ontology#MedicinalSubstance"/>
        <rdfs:range rdf:resource="https://w3id.org/vtmo/ontology#Meridian"/>
        <rdfs:comment xml:lang="en">Relates a medicinal substance to a traditional medicine meridian.</rdfs:comment>
        <rdfs:label xml:lang="en">belongs To Meridian</rdfs:label>
        <rdfs:label xml:lang="vi">quy vào kinh</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/vtmo/ontology#hasAdministrationMethod -->

    <owl:ObjectProperty rdf:about="https://w3id.org/vtmo/ontology#hasAdministrationMethod">
        <rdfs:domain rdf:resource="https://w3id.org/vtmo/ontology#MedicinalSubstance"/>
        <rdfs:range rdf:resource="https://w3id.org/vtmo/ontology#AdministrationMethod"/>
        <rdfs:comment xml:lang="en">Relates a medicinal substance to its recommended administration method.</rdfs:comment>
        <rdfs:label xml:lang="vi">có cách dùng</rdfs:label>
        <rdfs:label xml:lang="en">has Administration Method</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/vtmo/ontology#hasDosageSpecification -->

    <owl:ObjectProperty rdf:about="https://w3id.org/vtmo/ontology#hasDosageSpecification">
        <rdfs:domain rdf:resource="https://w3id.org/vtmo/ontology#MedicinalSubstance"/>
        <rdfs:range rdf:resource="https://w3id.org/vtmo/ontology#DosageSpecification"/>
        <rdfs:comment xml:lang="en">Relates a medicinal substance to its recommended dosage specification.</rdfs:comment>
        <rdfs:label xml:lang="vi">có đặc tả liều dùng</rdfs:label>
        <rdfs:label xml:lang="en">has dosage specification</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/vtmo/ontology#hasIndication -->

    <owl:ObjectProperty rdf:about="https://w3id.org/vtmo/ontology#hasIndication">
        <rdfs:domain rdf:resource="https://w3id.org/vtmo/ontology#MedicinalSubstance"/>
        <rdfs:range rdf:resource="https://w3id.org/vtmo/ontology#Disease"/>
        <rdfs:comment xml:lang="en">Relates a medicinal substance to a disease or medical condition for which it is indicated.</rdfs:comment>
        <rdfs:label xml:lang="vi">có chỉ định</rdfs:label>
        <rdfs:label xml:lang="en">has indication</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/vtmo/ontology#hasProperty -->

    <owl:ObjectProperty rdf:about="https://w3id.org/vtmo/ontology#hasProperty">
        <rdfs:domain rdf:resource="https://w3id.org/vtmo/ontology#MedicinalSubstance"/>
        <rdfs:range rdf:resource="https://w3id.org/vtmo/ontology#Property"/>
        <rdfs:comment xml:lang="en">Relates a medicinal substance to its traditional medicinal property.</rdfs:comment>
        <rdfs:label xml:lang="vi">có tính</rdfs:label>
        <rdfs:label xml:lang="en">has Property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/vtmo/ontology#hasScientificName -->

    <owl:ObjectProperty rdf:about="https://w3id.org/vtmo/ontology#hasScientificName">
        <rdfs:domain rdf:resource="https://w3id.org/vtmo/ontology#MedicinalSubstance"/>
        <rdfs:range rdf:resource="https://w3id.org/vtmo/ontology#ScientificName"/>
        <rdfs:comment xml:lang="en">Relates a medicinal substance to its accepted scientific name.</rdfs:comment>
        <rdfs:label xml:lang="vi">có tên khoa học</rdfs:label>
        <rdfs:label xml:lang="en">has scientific name</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/vtmo/ontology#hasTaste -->

    <owl:ObjectProperty rdf:about="https://w3id.org/vtmo/ontology#hasTaste">
        <rdfs:domain rdf:resource="https://w3id.org/vtmo/ontology#MedicinalSubstance"/>
        <rdfs:range rdf:resource="https://w3id.org/vtmo/ontology#Taste"/>
        <rdfs:comment xml:lang="en">Relates a medicinal substance to its traditional medicinal taste.</rdfs:comment>
        <rdfs:label xml:lang="vi">có vị</rdfs:label>
        <rdfs:label xml:lang="en">has Taste</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/vtmo/ontology#hasTherapeuticFunction -->

    <owl:ObjectProperty rdf:about="https://w3id.org/vtmo/ontology#hasTherapeuticFunction">
        <rdfs:domain rdf:resource="https://w3id.org/vtmo/ontology#MedicinalSubstance"/>
        <rdfs:range rdf:resource="https://w3id.org/vtmo/ontology#TherapeuticFunction"/>
        <rdfs:comment xml:lang="en">Relates a medicinal substance to its therapeutic function in traditional medicine.</rdfs:comment>
        <rdfs:label xml:lang="vi">có công năng</rdfs:label>
        <rdfs:label xml:lang="en">has therapeutic function</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/vtmo/ontology#usesPart -->

    <owl:ObjectProperty rdf:about="https://w3id.org/vtmo/ontology#usesPart">
        <rdfs:domain rdf:resource="https://w3id.org/vtmo/ontology#MedicinalSubstance"/>
        <rdfs:range rdf:resource="https://w3id.org/vtmo/ontology#MedicinalPart"/>
        <rdfs:comment xml:lang="en">Relates a medicinal substance to the plant part used medicinally.</rdfs:comment>
        <rdfs:label xml:lang="vi">sử dụng bộ phận</rdfs:label>
        <rdfs:label xml:lang="en">uses part</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/vtmo/ontology#confidenceScore -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/vtmo/ontology#confidenceScore">
        <rdfs:domain rdf:resource="https://w3id.org/vtmo/ontology#EvidenceAssertion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Specifies the confidence score assigned to an evidence assertion.</rdfs:comment>
        <rdfs:label xml:lang="en">confidence score</rdfs:label>
        <rdfs:label xml:lang="vi">điểm tin cậy</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/vtmo/ontology#dosageText -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/vtmo/ontology#dosageText">
        <rdfs:domain rdf:resource="https://w3id.org/vtmo/ontology#DosageSpecification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Provides a textual description of the recommended dosage for a medicinal substance.</rdfs:comment>
        <rdfs:label xml:lang="en">dosage text</rdfs:label>
        <rdfs:label xml:lang="vi">mô tả liều dùng</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/vtmo/ontology#doseUnit -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/vtmo/ontology#doseUnit">
        <rdfs:domain rdf:resource="https://w3id.org/vtmo/ontology#DosageSpecification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">specifies the unit used to express dosage values in a dosage specification for a medicinal substance.</rdfs:comment>
        <rdfs:label xml:lang="en">dose unit</rdfs:label>
        <rdfs:label xml:lang="vi">đơn vị liều dùng</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/vtmo/ontology#maximumDose -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/vtmo/ontology#maximumDose">
        <rdfs:domain rdf:resource="https://w3id.org/vtmo/ontology#DosageSpecification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">specifies the maximum recommended dosage value in a dosage specification for a medicinal substance.</rdfs:comment>
        <rdfs:label xml:lang="vi">liều tối đa</rdfs:label>
        <rdfs:label xml:lang="en">maximum dose</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/vtmo/ontology#minimumDose -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/vtmo/ontology#minimumDose">
        <rdfs:domain rdf:resource="https://w3id.org/vtmo/ontology#DosageSpecification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">specifies the minimum recommended dosage value in a dosage specification for a medicinal substance.</rdfs:comment>
        <rdfs:label xml:lang="vi">liều tối thiểu</rdfs:label>
        <rdfs:label xml:lang="en">minimum dose</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/vtmo/ontology#recordID -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/vtmo/ontology#recordID">
        <rdfs:domain rdf:resource="https://w3id.org/vtmo/ontology#DecisionRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Specifies the unique identifier assigned to a decision record.</rdfs:comment>
        <rdfs:label xml:lang="vi">mã hồ sơ</rdfs:label>
        <rdfs:label xml:lang="en">record identifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/vtmo/ontology#recordStatus -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/vtmo/ontology#recordStatus">
        <rdfs:domain rdf:resource="https://w3id.org/vtmo/ontology#DecisionRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Specifies the current status of a decision record.</rdfs:comment>
        <rdfs:label xml:lang="en">record status</rdfs:label>
        <rdfs:label xml:lang="vi">trạng thái hồ sơ</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/vtmo/ontology#recordVersion -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/vtmo/ontology#recordVersion">
        <rdfs:domain rdf:resource="https://w3id.org/vtmo/ontology#DecisionRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Specifies the version identifier of a decision record</rdfs:comment>
        <rdfs:label xml:lang="vi">phiên bản hồ sơ</rdfs:label>
        <rdfs:label xml:lang="en">record version</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/vtmo/ontology#verificationDate -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/vtmo/ontology#verificationDate">
        <rdfs:domain rdf:resource="https://w3id.org/vtmo/ontology#EvidenceAssertion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Specifies the date on which a record was verified</rdfs:comment>
        <rdfs:label xml:lang="vi">ngày kiểm định</rdfs:label>
        <rdfs:label xml:lang="en">verification date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/vtmo/ontology#vietnameseName -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/vtmo/ontology#vietnameseName">
        <rdfs:domain rdf:resource="https://w3id.org/vtmo/ontology#MedicinalSubstance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Specifies the Vietnamese name of a medicinal substance.</rdfs:comment>
        <rdfs:label xml:lang="en">Vietnamese name</rdfs:label>
        <rdfs:label xml:lang="vi">tên tiếng Việt</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/vtmo/ontology#AdministrationMethod -->

    <owl:Class rdf:about="https://w3id.org/vtmo/ontology#AdministrationMethod">
        <rdfs:comment xml:lang="en">The recommended method for administering a medicinal substance.</rdfs:comment>
        <rdfs:label xml:lang="en">Administration Method</rdfs:label>
        <rdfs:label xml:lang="vi">Cách dùng</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/vtmo/ontology#DecisionRecord -->

    <owl:Class rdf:about="https://w3id.org/vtmo/ontology#DecisionRecord">
        <rdfs:comment xml:lang="en">A record documenting decisions made during ontology development and governance.</rdfs:comment>
        <rdfs:label xml:lang="vi">Biên bản quyết định</rdfs:label>
        <rdfs:label xml:lang="en">Decision Record</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/vtmo/ontology#Disease -->

    <owl:Class rdf:about="https://w3id.org/vtmo/ontology#Disease">
        <rdfs:comment xml:lang="en">A disease or medical condition that may be treated by a medicinal substance.</rdfs:comment>
        <rdfs:label xml:lang="vi">Bệnh</rdfs:label>
        <rdfs:label xml:lang="en">Disease</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/vtmo/ontology#DosageSpecification -->

    <owl:Class rdf:about="https://w3id.org/vtmo/ontology#DosageSpecification">
        <rdfs:comment xml:lang="en">A specification describing the recommended dosage of a medicinal substance.</rdfs:comment>
        <rdfs:label xml:lang="en">Dosage Specification</rdfs:label>
        <rdfs:label xml:lang="vi">Đặc tả liều dùng</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/vtmo/ontology#EvidenceAssertion -->

    <owl:Class rdf:about="https://w3id.org/vtmo/ontology#EvidenceAssertion">
        <rdfs:comment xml:lang="en">A verified assertion supported by one or more evidence sources.</rdfs:comment>
        <rdfs:label xml:lang="en">Evidence Assertion</rdfs:label>
        <rdfs:label xml:lang="vi">Phát biểu chứng cứ</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/vtmo/ontology#EvidenceSource -->

    <owl:Class rdf:about="https://w3id.org/vtmo/ontology#EvidenceSource">
        <rdfs:comment xml:lang="en">A source providing evidence to support medicinal knowledge.</rdfs:comment>
        <rdfs:label xml:lang="en">Evidence Source</rdfs:label>
        <rdfs:label xml:lang="vi">Nguồn chứng cứ</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/vtmo/ontology#MedicinalPart -->

    <owl:Class rdf:about="https://w3id.org/vtmo/ontology#MedicinalPart">
        <rdfs:comment xml:lang="en">The part of a medicinal plant used for therapeutic or medicinal purposes.</rdfs:comment>
        <rdfs:label xml:lang="vi">Bộ phận dùng</rdfs:label>
        <rdfs:label xml:lang="en">Medicinal Part</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/vtmo/ontology#MedicinalSubstance -->

    <owl:Class rdf:about="https://w3id.org/vtmo/ontology#MedicinalSubstance">
        <rdfs:comment xml:lang="en">A medicinal plant or medicinal substance used in Vietnamese traditional medicine.</rdfs:comment>
        <rdfs:label xml:lang="vi">Dược liệu</rdfs:label>
        <rdfs:label xml:lang="en">Medicinal Substance</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/vtmo/ontology#Meridian -->

    <owl:Class rdf:about="https://w3id.org/vtmo/ontology#Meridian">
        <rdfs:comment xml:lang="en">A traditional medicine meridian associated with a medicinal substance.</rdfs:comment>
        <rdfs:label xml:lang="en">Meridian</rdfs:label>
        <rdfs:label xml:lang="vi">Quy kinh</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/vtmo/ontology#PlantFamily -->

    <owl:Class rdf:about="https://w3id.org/vtmo/ontology#PlantFamily">
        <rdfs:comment xml:lang="en">The botanical family to which a medicinal plant belongs.</rdfs:comment>
        <rdfs:label xml:lang="vi">Họ thực vật</rdfs:label>
        <rdfs:label xml:lang="en">Plant Family</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/vtmo/ontology#Property -->

    <owl:Class rdf:about="https://w3id.org/vtmo/ontology#Property">
        <rdfs:comment xml:lang="en">The traditional medicinal property, such as cold, warm or neutral, of a medicinal substance.</rdfs:comment>
        <rdfs:label xml:lang="en">Property</rdfs:label>
        <rdfs:label xml:lang="vi">Tính</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/vtmo/ontology#ScientificName -->

    <owl:Class rdf:about="https://w3id.org/vtmo/ontology#ScientificName">
        <rdfs:comment xml:lang="en">The accepted scientific name assigned to a medicinal substance</rdfs:comment>
        <rdfs:label xml:lang="en">Scientific Name</rdfs:label>
        <rdfs:label xml:lang="vi">Tên khoa học</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/vtmo/ontology#Taste -->

    <owl:Class rdf:about="https://w3id.org/vtmo/ontology#Taste">
        <rdfs:comment xml:lang="en">The traditional medicinal taste characteristic of a medicinal substance.</rdfs:comment>
        <rdfs:label xml:lang="en">Taste</rdfs:label>
        <rdfs:label xml:lang="vi">Vị</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/vtmo/ontology#TherapeuticFunction -->

    <owl:Class rdf:about="https://w3id.org/vtmo/ontology#TherapeuticFunction">
        <rdfs:comment xml:lang="en">A therapeutic function or traditional medicinal action of a medicinal substance.</rdfs:comment>
        <rdfs:label xml:lang="vi">Công năng</rdfs:label>
        <rdfs:label xml:lang="en">Therapeutic Function</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/vtmo/ontology#Administration_MS001 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/vtmo/ontology#Administration_MS001">
        <rdf:type rdf:resource="https://w3id.org/vtmo/ontology#AdministrationMethod"/>
        <rdfs:comment xml:lang="en">Administration method for Mentha arvensis L.</rdfs:comment>
        <rdfs:label xml:lang="en">Administration_MS001</rdfs:label>
        <rdfs:label xml:lang="vi">Cách dùng Bạc hà</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/vtmo/ontology#Disease_ChestHypochondriacFullness -->

    <owl:NamedIndividual rdf:about="https://w3id.org/vtmo/ontology#Disease_ChestHypochondriacFullness">
        <rdf:type rdf:resource="https://w3id.org/vtmo/ontology#Disease"/>
        <rdfs:comment xml:lang="en">Represents chest and hypochondriac fullness as an indication in Vietnamese Traditional Medicine.</rdfs:comment>
        <rdfs:label xml:lang="en">Chest and Hypochondriac Fullness</rdfs:label>
        <rdfs:label xml:lang="vi">Ngực sườn đầy tức</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/vtmo/ontology#Disease_Headache -->

    <owl:NamedIndividual rdf:about="https://w3id.org/vtmo/ontology#Disease_Headache">
        <rdf:type rdf:resource="https://w3id.org/vtmo/ontology#Disease"/>
        <rdfs:comment xml:lang="en">Represents headache as an indication in Vietnamese Traditional Medicine.</rdfs:comment>
        <rdfs:label xml:lang="en">Headache</rdfs:label>
        <rdfs:label xml:lang="vi">Nhức đầu</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/vtmo/ontology#Disease_Influenza -->

